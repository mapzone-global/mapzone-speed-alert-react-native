{
  "name": "@mapzone/speed-alert",
  "version": "1.0.0",
  "description": "Speed-limit, camera, toll and restriction alerts from the road network around the vehicle (zone-based, no route needed) for React Native apps.",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "files": [
    "build",
    "src",
    "android",
    "ios",
    "expo-module.config.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "!src/__tests__",
    "!android/build",
    "!ios/build",
    "!**/.*"
  ],
  "scripts": {
    "build": "node internal/module_scripts/build.js",
    "clean": "node internal/module_scripts/clean.js",
    "lint": "eslint src/",
    "test": "node internal/module_scripts/test.js",
    "prepare": "node internal/module_scripts/prepare.js",
    "prepack": "node internal/module_scripts/prepare.js",
    "open:ios": "node internal/module_scripts/open-ios.js",
    "open:android": "node internal/module_scripts/open-android.js"
  },
  "keywords": [
    "react-native",
    "expo",
    "expo-module",
    "mapzone",
    "vietmap",
    "speed-alert",
    "speed-limit",
    "speed-camera"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/mapzone-global/mapzone-speed-alert-react-native"
  },
  "bugs": {
    "url": "https://github.com/mapzone-global/mapzone-speed-alert-react-native/issues"
  },
  "author": "Map Zone <toannn@vietmap.vn>",
  "license": "MIT",
  "homepage": "https://github.com/mapzone-global/mapzone-speed-alert-react-native",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.19.4"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@types/jest": "^29.2.1",
    "@types/react": "~19.2.0",
    "babel-preset-expo": "~57.0.12",
    "eslint": "~9.39.4",
    "eslint-config-universe": "^15.0.3",
    "expo": "~57.0.23",
    "expo-image": "~57.0.5",
    "expo-modules-core": "~57.0.18",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.5",
    "prettier": "^3.0.0",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "typescript": "^5.9.2"
  },
  "jest": {
    "preset": "jest-expo",
    "roots": [
      "<rootDir>/src"
    ]
  },
  "peerDependencies": {
    "expo": ">=57",
    "expo-image": ">=3",
    "react": "*",
    "react-native": ">=0.86"
  }
}
